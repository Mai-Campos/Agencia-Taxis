---
import Footer from '@/components/layout/Footer.astro'
import HeaderScroll from '@/components/layout/HeaderScroll.astro'
import HeaderStatic from '@/components/layout/HeaderStatic.astro'
import type { Language, NavBarTranslations } from '@/i18n/types'
import '@fontsource-variable/inter'
import '@fontsource/poppins'

interface Props {
  headerType?: 'scroll' | 'static'
  title: string
  navbar: NavBarTranslations
  lang: Language
}

const { headerType = 'scroll', title, navbar, lang } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{`Crystal Sands Ride | ${title}`}</title>
  </head>
  <body
    class="bg-background text-text-main selection:text-text-main body-font selection:bg-blue-300"
  >
    {
      headerType === 'scroll' ? (
        <HeaderScroll navbar={navbar} />
      ) : (
        <HeaderStatic navbar={navbar} />
      )
    }
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
