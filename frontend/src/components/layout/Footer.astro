---
import { Icon } from 'astro-icon/components'
import type { FooterProps } from '@/components/layout/types/types'
import LanguagePicker from '@/components/ui/LanguagePicker.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props {
  footer: FooterProps
}

const currentLang = Astro.currentLocale || 'es'
const { footer } = Astro.props
const { brand, links, contact, legal } = footer
---

<footer class="bg-gray-50 text-gray-700">
  <div class="container mx-auto px-6 pt-12 pb-6">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-3">
          <img src="/favicon.svg" alt="Crystal Travels Logo" class="h-8 w-8" />
          <span class="text-lg font-semibold">Crystal Sands Ride</span>
        </a>
        <p class="text-text-secondary text-sm">
          {brand.description}
        </p>

        <div class="mt-2 flex gap-3">
          <a aria-label="TripAdvisor" href="#">
            <Icon
              name="tabler:brand-tripadvisor"
              size={28}
              class="hover:text-primary-hover active:text-primary-hover color-transition"
            />
          </a>
          <a aria-label="Instagram" href="#">
            <Icon
              name="tabler:brand-instagram"
              size={28}
              class="hover:text-primary-hover active:text-primary-hover color-transition"
            />
          </a>
          <a aria-label="Facebook" href="#">
            <Icon
              name="tabler:brand-facebook"
              size={28}
              class="hover:text-primary-hover active:text-primary-hover color-transition"
            />
          </a>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="mb-4 font-semibold">{links.title}</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href={`${getRelativeLocaleUrl(currentLang, '/')}#services`}
              class="footer-link"
            >
              {links.services}
            </a>
            <li>
              <a
                href={getRelativeLocaleUrl(currentLang, 'trips')}
                class="footer-link">{links.trips}</a
              >
            </li>
            <li>
              <a
                href={getRelativeLocaleUrl(currentLang, 'check-booking')}
                class="footer-link">{links.checkBook}</a
              >
            </li>
          </li>
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="mb-4 font-semibold">{contact.title}</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/about" class="footer-link"
              ><Icon
                name="tabler:brand-whatsapp"
                size={16}
                class="mr-2 inline-block"
              />
              +555 5555 555</a
            >
          </li>
          <li>
            <a href="/tours" class="footer-link"
              ><Icon name="tabler:mail" size={16} class="mr-2 inline-block" />
              email@email.com</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-gray-200 sm:flex-row"
    >
      <p class="text-sm">
        {legal.copyright}
      </p>
    </div>
  </div>
</footer>
