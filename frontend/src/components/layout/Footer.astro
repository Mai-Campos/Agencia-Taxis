---
import FooterCard from '@/components/ui/FooterCard.astro'
import { Icon } from 'astro-icon/components'
---

<footer class="body-font bg-surface">
  <div
    class="container mx-auto flex flex-col flex-wrap px-5 py-24 md:flex-row md:flex-nowrap md:items-center lg:items-start"
  >
    <div class="mx-auto w-64 shrink-0 text-center md:mx-0 md:text-left">
      <a
        class="title-font flex items-center justify-center font-medium md:justify-start"
      >
        <span class="ml-3 text-xl">Crystal Sands Ride</span>
      </a>
    </div>
    <div
      class="mt-10 -mb-10 flex grow flex-wrap text-center md:mt-0 md:pl-20 md:text-left"
    >
      <FooterCard />
      <FooterCard />
      <FooterCard />
    </div>
  </div>
  <div class="bg-gray-100">
    <div
      class="container mx-auto flex flex-col flex-wrap px-5 py-4 sm:flex-row"
    >
      <p class="text-center text-sm text-gray-500 sm:text-left">
        © 2020 Tailblocks —
        <a
          href="https://twitter.com/knyttneve"
          rel="noopener noreferrer"
          class="ml-1 text-gray-600"
          target="_blank">@knyttneve</a
        >
      </p>
      <span
        class="mt-2 inline-flex justify-center sm:mt-0 sm:ml-auto sm:justify-start"
      >
        <a class="text-gray-500">
          <Icon name="tabler:brand-tripadvisor" size={24} />
        </a>
        <a class="ml-3 text-gray-500">
          <Icon name="tabler:brand-whatsapp" size={24} />
        </a>
        <a class="ml-3 text-gray-500">
          <Icon name="tabler:brand-facebook" size={24} />
        </a>
        <a class="ml-3 text-gray-500">
          <Icon name="tabler:brand-instagram" size={24} />
        </a>
      </span>
    </div>
  </div>
</footer>
