---
import type { NavBarTranslations } from '@/i18n/types'
import LanguagePicker from '../ui/LanguagePicker.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'

export interface Props {
  navbar: NavBarTranslations
}

const currentLang = Astro.currentLocale || 'es'
const { navbar } = Astro.props
---

<nav
  class="body-font flex flex-col items-center justify-center gap-6 text-lg font-medium md:flex-row"
>
  <LanguagePicker label={navbar.language} />
  <a
    href="#services"
    class="color-transition hover:text-primary-hover active:text-primary-hover cursor-pointer"
    >{navbar.services}</a
  >
  <a
    href={getRelativeLocaleUrl(currentLang, 'trips')}
    class="color-transition hover:text-primary-hover active:text-primary-hover cursor-pointer"
    >{navbar.travels}</a
  >
  <a
    href={getRelativeLocaleUrl(currentLang, 'check-booking')}
    class="color-transition hover:text-primary-hover active:text-primary-hover cursor-pointer"
    >{navbar.checkBooking}</a
  >
</nav>
