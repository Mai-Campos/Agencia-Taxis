---
import type { NavBarTranslations } from '@/i18n/types'
import LanguagePicker from '../ui/LanguagePicker.astro'

export interface Props {
  navbar: NavBarTranslations
}

const { navbar } = Astro.props
---

<nav
  class="mt-4 flex flex-col items-center justify-center text-base rounded-xl shadow m-2 md:mt-0 md:flex-row md:space-x-8 md:text-sm md:font-medium"
>
  <LanguagePicker />
  <a
    href="/"
    class="hover:text-primary-hover active:text-primary-hover cursor-pointer"
    >{navbar.services}</a
  >
  <a
    href="/trips"
    class="hover:text-primary-hover active:text-primary-hover cursor-pointer"
    >{navbar.travels}</a
  >
  <a
    href="/check-booking"
    class="hover:text-primary-hover active:text-primary-hover cursor-pointer"
    >{navbar.checkBooking}</a
  >
</nav>
