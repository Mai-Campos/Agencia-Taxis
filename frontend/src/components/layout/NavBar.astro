---
import type { NavBarTranslations } from '@/i18n/types'

export interface Props {
  navbar: NavBarTranslations
}

const { navbar } = Astro.props
---

<nav
  class="flex flex-wrap items-center justify-center gap-3 text-base md:ml-auto md:gap-5"
>
  <a
    href="/"
    class="hover:text-primary-hover active:text-primary-hover cursor-pointer"
    >{navbar.services}</a
  >
  <a
    href="/trips"
    class="hover:text-primary-hover active:text-primary-hover cursor-pointer"
    >{navbar.travels}</a
  >
  <a
    href="/check-booking"
    class="hover:text-primary-hover active:text-primary-hover cursor-pointer"
    >{navbar.checkBooking}</a
  >
</nav>
