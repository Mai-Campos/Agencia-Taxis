---
import type { NavBarTranslations } from '@/i18n/types'
import LanguagePicker from '../ui/LanguagePicker.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'

export interface Props {
  navbar: NavBarTranslations
}

const currentLang = Astro.currentLocale || 'es'
const { navbar } = Astro.props
---

<nav
  class="body-font text-lg font-medium"
>
  <ul class="flex flex-col items-center justify-center gap-6 md:flex-row">
    <li class="color-transition hover:text-primary-hover active:text-primary-hover"><LanguagePicker label={navbar.language} /></li>
    <li class="color-transition hover:text-primary-hover active:text-primary-hover">
      <a
        href="#services"
        class="cursor-pointer"
        >{navbar.services}</a>
    </li>
    <li class="color-transition hover:text-primary-hover active:text-primary-hover">
      <a
        href={getRelativeLocaleUrl(currentLang, 'trips')}
        class="cursor-pointer"
        >{navbar.travels}</a>
    </li>
    <li class="color-transition hover:text-primary-hover active:text-primary-hover">
      <a
        href={getRelativeLocaleUrl(currentLang, 'check-booking')}
        class="cursor-pointer"
        >{navbar.checkBooking}</a>
    </li>
  </ul>
</nav>
