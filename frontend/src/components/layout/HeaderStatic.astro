---
import NavBar from '@/components/layout/NavBar.astro'
import type { NavBarTranslations } from '@/i18n/types'
import { Icon } from 'astro-icon/components'
import { getRelativeLocaleUrl } from 'astro:i18n'

export interface Props {
  navbar: NavBarTranslations
}

const currentLang = Astro.currentLocale || 'es'
const { navbar } = Astro.props
---

<header
  class="body-font bg-background text-text-main fixed top-0 z-50 w-full transition-colors duration-300"
  id="header"
>
  <div
    class="container mx-auto flex flex-wrap items-center justify-between p-4"
  >
    <a
      href={getRelativeLocaleUrl(currentLang, '/')}
      class="title-font flex cursor-pointer gap-4 text-xl font-bold md:mb-0"
    >
      <img
        alt="Crystal Sands Ride Logo"
        src="/favicon.svg"
        class="h-auto w-10"
      />
      Crystal Sands Ride
    </a>

    <div class="flex items-center">
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex items-center rounded-lg p-2 text-sm text-gray-500 hover:bg-gray-100 focus:ring-2 focus:ring-gray-200 focus:outline-none md:hidden"
      >
        <span class="sr-only">Open main menu</span>
        <!-- Hamburger icon -->
        <Icon name="tabler:menu-2" size={24} />
      </button>
    </div>

    <div class="hidden w-full md:block md:w-auto" id="mobile-menu">
      <NavBar navbar={navbar} />
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle')
  const mobileMenu = document.getElementById('mobile-menu')

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', function () {
      mobileMenu.classList.toggle('hidden')
    })
  }
</script>
