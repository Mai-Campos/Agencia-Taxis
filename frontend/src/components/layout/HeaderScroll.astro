---
import NavBar from '@/components/layout/NavBar.astro'
import type { NavBarTranslations } from '@/i18n/types'

export interface Props {
  scrollHeader?: boolean
  navbar: NavBarTranslations
}

const { scrollHeader = true, navbar } = Astro.props
---

<header
  class={`body-font fixed top-0 z-50 w-full transition-colors duration-300
    ${scrollHeader ? 'bg-transparent text-white' : 'bg-background text-text-main'}
  `}
  id="header"
>
  <div
    class="container mx-auto flex flex-col items-center p-4 md:flex-row md:justify-between"
  >
    <a href="/" class="title-font cursor-pointer text-xl font-bold md:mb-0">
      Crystal Sands Ride
    </a>
    <NavBar navbar={navbar} />
  </div>
</header>

<script>
  const header = document.getElementById('header')

  if (header) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        header.classList.add('bg-background', 'text-text-main')
        header.classList.remove('bg-transparent', 'text-white')
      } else {
        header.classList.remove('bg-background', 'text-text-main')
        header.classList.add('bg-transparent', 'text-white')
      }
    })
  }
</script>
