---
import NavBar from '@/components/layout/NavBar.astro'
import type { NavBarTranslations } from '@/i18n/types'
import { Icon } from 'astro-icon/components'
import { getRelativeLocaleUrl } from 'astro:i18n'

export interface Props {
  scrollHeader?: boolean
  navbar: NavBarTranslations
}

const currentLang = Astro.currentLocale || 'es'
const { scrollHeader = true, navbar } = Astro.props
---

<header
  class={`body-font fixed top-0 z-50 w-full transition-colors duration-300
    ${scrollHeader ? 'bg-transparent text-white' : 'bg-background text-text-main'}
  `}
  id="header"
>
  <div
    class="container mx-auto flex flex-wrap items-center justify-between p-4"
  >
    <a
      href={getRelativeLocaleUrl(currentLang, '/')}
      class="title-font cursor-pointer text-xl font-bold md:mb-0"
    >
      Crystal Sands Ride
    </a>

    <div class="flex items-center">
      <button
        id="menu-toggle"
        type="button"
        class="ml-3 inline-flex items-center rounded-lg p-2 text-sm hover:bg-gray-100 focus:ring-2 focus:ring-gray-200 focus:outline-none md:hidden"
      >
        <span class="sr-only">Open main menu</span>
        <!-- Hamburger icon -->
        <Icon name="tabler:menu-2" size={24} />
      </button>
    </div>

    <div
      class="bg-background text-text-main hidden w-full rounded-xl py-6 md:block md:w-auto md:bg-transparent md:py-0 md:text-inherit"
      id="mobile-menu"
    >
      <NavBar navbar={navbar} />
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('header')
  const menuToggle = document.getElementById('menu-toggle')
  const mobileMenu = document.getElementById('mobile-menu')

  if (header) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        header.classList.add('bg-background', 'text-text-main')
        header.classList.remove('bg-transparent', 'text-white')
      } else {
        header.classList.remove('bg-background', 'text-text-main')
        header.classList.add('bg-transparent', 'text-white')
      }
    })
  }
  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', function () {
      mobileMenu.classList.toggle('hidden')
    })
  }
</script>
