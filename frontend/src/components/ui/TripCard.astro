---
import { Icon } from 'astro-icon/components'

type Props = {
  location: string
  packageName: string
  img: string
}

const { location, packageName, img } = Astro.props
---

<article class="w-full">
  <a href="/trip">
    <div
      class="group shadow-card bg-surface relative h-80 w-full overflow-hidden rounded-xl"
    >
      <div
        class="bg-image absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out group-hover:scale-110"
      >
      </div>

      <div
        class="absolute inset-0 bg-black/30 transition-colors duration-500 group-hover:bg-black/40"
      >
      </div>

      <aside
        class="relative z-10 flex h-full flex-col justify-end p-4 text-white transition-all duration-500 select-none group-hover:translate-y-1"
      >
        <span
          class="title-font flex gap-1 text-xs font-medium tracking-widest uppercase opacity-90 transition-opacity duration-500 group-hover:opacity-100"
        >
          <Icon name="tabler:map-pin-filled" size={15} class="text-red-500" />{
            location
          }</span
        >

        <h3
          class="title-font text-lg font-medium text-pretty opacity-95 transition-opacity duration-500 group-hover:opacity-100"
        >
          {packageName}
        </h3>
      </aside>
    </div></a
  >
</article>

<style>
  .bg-image {
    background-image: url('/havana.webp');
  }
</style>
