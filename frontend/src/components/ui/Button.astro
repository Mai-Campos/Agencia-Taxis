---
type Props = {
  text: string
  className?: string[] | string
}
const { text, className } = Astro.props
---

<button
  class={`title-font bg-primary shadow-card hover:bg-primary-hover active:bg-primary-hover cursor-pointer rounded-xl px-6 py-4 font-semibold text-pretty text-white select-none focus:outline-none ${className}`}
  >{text}</button
>
