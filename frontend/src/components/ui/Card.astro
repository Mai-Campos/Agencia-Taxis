---
import { Icon } from 'astro-icon/components'
---

<article class="mx-auto p-4 md:w-1/2 xl:w-1/4">
  <a href="/">
    <div
      class="group shadow-card bg-surface relative h-80 w-full overflow-hidden rounded-xl"
    >
      <div
        class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out group-hover:scale-110"
        style="background-image: url('/havana.jpg');"
      >
      </div>

      <div
        class="absolute inset-0 bg-black/30 transition-colors duration-500 group-hover:bg-black/40"
      >
      </div>

      <div
        class="relative z-10 flex h-full flex-col justify-end p-4 text-white transition-all duration-500 group-hover:translate-y-1"
      >
        <h3
          class="title-font flex gap-1 text-xs font-medium tracking-widest uppercase opacity-90 transition-opacity duration-500 group-hover:opacity-100"
        >
          <Icon name="tabler:map-pin-filled" size={15} class="text-red-500" /> LA
          HABANA
        </h3>

        <h2
          class="title-font text-lg font-medium text-pretty opacity-95 transition-opacity duration-500 group-hover:opacity-100"
        >
          Recorrido por La Habana Vieja
        </h2>
      </div>
    </div></a
  >
</article>
