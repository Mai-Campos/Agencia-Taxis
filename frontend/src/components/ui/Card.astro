---
import { Icon } from 'astro-icon/components'
---

<article class="p-4 md:w-1/2 xl:w-1/4">
  <div class="rounded-lg bg-background-secondary shadow-xs">
    <img
      class="h-56 w-full rounded object-cover object-center"
      src="https://dummyimage.com/720x400"
      alt="content"
    />
    <div class="p-4">
      <h3
        class="title-font flex items-center gap-1 text-xs font-medium tracking-widest"
      >
        <Icon name="tabler:location" size={13} /> LA HABANA
      </h3>
      <h2 class="title-font text-lg font-medium">
        Recorrido por La Habana Vieja
      </h2>
      <a
        href="#"
        class="flex items-center justify-end gap-1 font-medium text-blue-500"
        >Detalles <Icon name="tabler:arrow-narrow-right" size={20} /></a
      >
    </div>
  </div>
</article>
