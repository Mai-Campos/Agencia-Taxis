---
import { Icon } from 'astro-icon/components'
---

<div class="p-4 md:w-1/3">
  <div class="bg-surface flex h-full flex-col rounded-lg p-8">
    <div class="mb-3 flex items-center">
      <div
        class="bg-primary mr-3 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-white"
      >
        <Icon name="tabler:user" size={22} />
      </div>
      <h2 class="title-font text-lg font-medium text-gray-900">
        Shooting Stars
      </h2>
    </div>
    <div class="grow">
      <p class="text-base leading-relaxed">
        Blue bottle crucifix vinyl post-ironic four dollar toast vegan
        taxidermy. Gastropub indxgo juice poutine.
      </p>
    </div>
  </div>
</div>
