---
import SubmitBtn from '../ui/SubmitBtn.astro'
---

<section class="body-font container mx-auto px-5 py-24">
  <div class="mb-12 flex w-full flex-col text-center">
    <h1 class="title-font mb-2 text-2xl font-bold sm:text-3xl">Traslados</h1>
    <p class="text-text-secondary mx-auto text-base lg:w-2/3">
      Traslados entre aeropuertos y casas de alquiler
    </p>
  </div>

  <div class="mx-auto md:w-2/3 lg:w-1/2">
    <form action="" class="-m-2 flex flex-wrap">
      <div class="w-full p-2 sm:w-1/2">
        <label class="text-text-secondary text-sm leading-7"
          >Name
          <input type="text" name="ownerName" class="input-component" required />
        </label>
      </div>

      <div class="w-full p-2 sm:w-1/2">
        <label class="text-text-secondary text-sm leading-7"
          >Email
          <input type="email" name="email" class="input-component" required />
        </label>
      </div>

      <div class="w-full p-2 sm:w-1/2">
        <label class="text-text-secondary text-sm leading-7"
          >Pick up location
          <input type="text" name="pickupLocation" class="input-component" required />
        </label>
      </div>

      <div class="w-full p-2 sm:w-1/2">
        <label class="text-text-secondary text-sm leading-7"
          >Destination
          <input type="text" name="destination" class="input-component" required />
        </label>
      </div>

      <div class="w-1/2 p-2">
        <label class="text-text-secondary text-sm leading-7"
          >Pick up date
          <input type="date" name="pickupDate" class="input-component" required />
        </label>
      </div>

      <div class="w-1/2 p-2">
        <label class="text-text-secondary text-sm leading-7"
          >Pick up time
          <input type="time" name="pickupTime" class="input-component" required />
        </label>
      </div>

      <div class="w-full p-2 sm:w-1/3">
        <label class="text-text-secondary text-sm leading-7"
          >Numero de vuelo (si aplica)
          <input type="number" name="flightNumber" class="input-component" />
        </label>
      </div>

      <div class="w-1/2 p-2 sm:w-1/3">
        <label class="text-text-secondary text-sm leading-7"
          >Passengers
          <input type="number" name="passengers" class="input-component" required />
        </label>
      </div>

      <div class="w-1/2 p-2 sm:w-1/3">
        <label class="text-text-secondary text-sm leading-7"
          >Vehicle
          <select name="passengers" class="input-component">
            <option value="taxi">Taxi</option>
            <option value="classic-car">Auto Clasico</option>
            <option value="van">Van</option>
          </select>
        </label>
      </div>

      <div class="w-full p-2">
        <label class="text-text-secondary text-sm leading-7"
          >Comments
          <textarea name="comments" class="textarea-component"></textarea>
        </label>
      </div>

      <div class="flex w-full items-center justify-center p-2">
        <SubmitBtn />
      </div>
    </form>
  </div>
</section>

<section class="body-font container w-1/2 mx-auto px-5 py-24">
  <aside class="text-left">
    <h2>Datos del traslado</h2>
  </aside>
  <main class="flex w-full flex-col">
    <div class="flex gap-1">
      <h3>Nombre de cliente:</h3>
      <span>Kevin Santamaria Davila</span>
    </div>
    <div class="flex gap-1">
      <h3>Email:</h3>
      <span>kevinsdasere@gmail.com</span>
    </div>
    <div class="flex gap-1">
      <h3>Numero de vuelo:</h3>
      <span>2231937</span>
    </div>
    <div>
      <h3>Lugar de recogida:</h3>
      <span>Aeropuerto Juan Gualberto Gomez</span>
    </div>
    <div>
      <h3>Lugar de destino:</h3>
      <span>Matanzas, Versalles, Sta Cristina #23203 E/ San Juan de la Cruz y Aranguren</span>
    </div>
    <div>
      <h3>Fecha y hora de recogida:</h3>
      <span>10/23/4213</span>
      <span>9:00 am</span>
    </div>
    <div>
      <h3>Cantidad de pasajeros:</h3>
      <span>3</span>
    </div>
    <div>
      <h3>Vehiculo del traslado:</h3>
      <span>Taxi</span>
    </div>
  </main>
</section>
