---
import Chip from '@/components/ui/Chip.astro'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

type Props = {
  location: string
  packageName: string
  placesToVisit: string[]
  price: string
  img: string
  description: string
}

const { location, packageName, placesToVisit, price, img, description } =
  Astro.props
---

<section class="body-font overflow-hidden">
  <div class="container mx-auto px-5 pt-20">
    <div class="mx-auto flex flex-wrap lg:w-4/5">
      <Image
        src={img}
        alt={location}
        width={700}
        height={700}
        class="h-64 w-full rounded-xl object-cover object-center lg:h-auto lg:w-1/2"
      />
      <div class="mt-6 w-full lg:mt-0 lg:w-1/2 lg:py-6 lg:pl-10">
        <span
          class="title-font flex gap-1 text-sm font-medium tracking-widest uppercase"
        >
          <Icon name="tabler:map-pin-filled" size={18} class="text-red-500" />{
            location
          }
        </span>
        <h1 class="title-font mb-1 text-3xl font-medium">
          {packageName}
        </h1>
        <div class="mb-4 flex flex-wrap gap-2">
          {placesToVisit.map((place) => <Chip text={place} />)}
        </div>
        <p class="leading-relaxed">
          {description}
        </p>
        <div class="mt-4 flex items-center justify-between">
          <span class="title-font text-2xl font-medium text-gray-900"
            >{price}</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
