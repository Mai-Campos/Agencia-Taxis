---
import type { bookDetails } from '@/components/sections/types/types'

interface Props {
  bookDetails: bookDetails
}

const { bookDetails } = Astro.props
const {
  title,
  subtitle,
  clientInfo,
  pickupDetails,
  serviceInfo,
  additionalInfo,
} = bookDetails
---

<section>
  <div class="container mx-auto px-5 py-12">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-semibold">{title}</h1>
      <p class="text-text-secondary mt-2">
        {subtitle}
      </p>
    </div>

    <div class="bg-surface mx-auto space-y-10 rounded-lg p-8 lg:w-2/3">
      <!-- Datos del Cliente -->
      <div>
        <h2 class="mb-4 text-xl font-semibold">
          {clientInfo.title}
        </h2>
        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <p class="text-text-secondary text-sm">{clientInfo.name}</p>
            <p class="font-medium text-gray-800">Juan Pérez</p>
          </div>
          <div>
            <p class="text-text-secondary text-sm">{clientInfo.email}</p>
            <p class="font-medium text-gray-800">juanperez@mail.com</p>
          </div>
        </div>
      </div>

      <!-- Datos de Pickup -->
      <div>
        <h2 class="mb-4 text-xl font-semibold">
          {pickupDetails.title}
        </h2>

        <div class="grid gap-4 md:grid-cols-3">
          <div>
            <p class="text-text-secondary text-sm">
              {pickupDetails.pickupLocation}
            </p>
            <p class="font-medium text-gray-800">Aeropuerto Internacional</p>
          </div>

          <div>
            <p class="text-text-secondary text-sm">{pickupDetails.date}</p>
            <p class="font-medium text-gray-800">2025-06-22</p>
          </div>

          <div>
            <p class="text-text-secondary text-sm">{pickupDetails.time}</p>
            <p class="font-medium text-gray-800">14:30</p>
          </div>
        </div>
      </div>

      <!-- Información del Servicio -->
      <div>
        <h2 class="mb-4 text-xl font-semibold">
          {serviceInfo.title}
        </h2>

        <div class="grid gap-4 md:grid-cols-2">
          <!-- Solo aparece si es Traslado -->
          <div>
            <p class="text-text-secondary text-sm">{serviceInfo.destination}</p>
            <p class="font-medium text-gray-800">Hotel Central</p>
          </div>

          <!-- Solo aparece si es Traslado -->
          <div>
            <p class="text-text-secondary text-sm">
              {serviceInfo.flightNumber}
            </p>
            <p class="font-medium text-gray-800">AR1234</p>
          </div>

          <!-- Solo aparece si es Recorrido -->
          <div>
            <p class="text-text-secondary text-sm">{serviceInfo.trip}</p>
            <p class="font-medium text-gray-800">Tour Ciudad Completa</p>
          </div>

          <!-- Solo aparece si es Recorrido -->
          <div>
            <p class="text-text-secondary text-sm">
              {serviceInfo.guideLanguage}
            </p>
            <p class="font-medium text-gray-800">Inglés</p>
          </div>
        </div>
      </div>

      <!-- Datos extra -->
      <div>
        <h2 class="mb-4 text-xl font-semibold">
          {additionalInfo.title}
        </h2>

        <div class="grid gap-4 md:grid-cols-3">
          <div>
            <p class="text-text-secondary text-sm">
              {additionalInfo.passengers}
            </p>
            <p class="font-medium text-gray-800">3</p>
          </div>
          <div>
            <p class="text-text-secondary text-sm">{additionalInfo.vehicle}</p>
            <p class="font-medium text-gray-800">SUV</p>
          </div>
        </div>

        <div class="mt-4">
          <p class="text-text-secondary text-sm">{additionalInfo.comments}</p>
          <p class="font-medium text-gray-800">
            Por favor, esperarme con un cartel. Viajo con niños.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
