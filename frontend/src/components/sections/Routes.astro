---
import Card from '../ui/Card.astro'
---

<section class="body-font">
  <div class="container mx-auto px-5 py-24">
    <div class="mx-auto mb-20 flex w-full flex-wrap md:max-w-[1100px]">
      <div class="mb-6 w-full lg:mb-0 lg:w-1/2">
        <h1 class="title-font mb-2 text-2xl font-medium sm:text-3xl">
          Recorridos
        </h1>
        <div class="bg-primary h-1 w-20 rounded"></div>
      </div>
      <p class="text-foreground-secondary w-full leading-relaxed lg:w-1/2">
        Whatever cardigan tote bag tumblr hexagon brooklyn asymmetrical
        gentrify, subway tile poke farm-to-table. Franzen you probably haven't
        heard of them man bun deep jianbing selfies heirloom prism food truck
        ugh squid celiac humblebrag.
      </p>
    </div>
    <div class="-m-4 flex flex-wrap">
      <Card />
      <Card />
      <Card />
      <Card />
    </div>
  </div>
</section>
