---
import BookDetails from '@/components/sections/details-sections/BookDetails'
import CheckBookForm from '@/components/forms/CheckBookForm'
import type {
  BookingLabels,
  BookingOptions,
} from '@/components/sections/types/types'

interface Props {
  title: string
  description: string
  button: string
  invalidNumber: string
  bookingLabels: BookingLabels
  options: BookingOptions
  lang: string
}

const {
  title,
  description,
  button,
  invalidNumber,
  bookingLabels,
  options,
  lang,
} = Astro.props
---

<section>
  <div class="container mx-auto px-5 py-24">
    <div class="mb-12 flex w-full flex-col text-center">
      <h1 class="title-font mb-4 text-2xl font-medium sm:text-3xl">
        {title}
      </h1>
      <p class="text-text-secondary mx-auto leading-relaxed lg:w-2/3">
        {description}
      </p>
    </div>
    <div class="flex justify-center">
      <CheckBookForm
        client:load
        buttonText={button}
        invalidNumber={invalidNumber}
      />
    </div>
    <div class="mt-5">
      <BookDetails
        labels={bookingLabels}
        options={options}
        lang={lang}
        client:load
      />
    </div>
  </div>
</section>
