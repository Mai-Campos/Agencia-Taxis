---
import BookDetails from '@/components/sections/details-sections/BookDetails.astro'
import CheckBookForm from '@/components/forms/CheckBookForm'
import type { bookDetails } from '@/components/sections/types/types'

interface Props {
  title: string
  description: string
  button: string
  invalidNumber: string
  bookDetails: bookDetails
}

const { title, description, button, invalidNumber, bookDetails } = Astro.props
---

<section>
  <div class="container mx-auto px-5 py-24">
    <div class="mb-12 flex w-full flex-col text-center">
      <h1 class="title-font mb-4 text-2xl font-medium sm:text-3xl">
        {title}
      </h1>
      <p class="text-text-secondary mx-auto leading-relaxed lg:w-2/3">
        {description}
      </p>
    </div>
    <div class="flex justify-center">
      <CheckBookForm
        client:load
        buttonText={button}
        invalidNumber={invalidNumber}
      />
    </div>
    <div class="mt-5">
      <BookDetails bookDetails={bookDetails} />
    </div>
  </div>
</section>
