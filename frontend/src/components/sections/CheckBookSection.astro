---
import BookDetails from '@/components/sections/details-sections/BookDetails.astro'
import CheckBookForm from '@/components/forms/CheckBookForm'

interface Props {
  title: string
  description: string
  button: string
  invalidNumber: string
}

const { title, description, button, invalidNumber } = Astro.props
---

<section class="body-font">
  <div class="container mx-auto px-5 py-24">
    <div class="mb-12 flex w-full flex-col text-center">
      <h1
        class="title-font text-text-main mb-4 text-2xl font-medium sm:text-3xl"
      >
        {title}
      </h1>
      <p class="text-text-secondary mx-auto leading-relaxed lg:w-2/3">
        {description}
      </p>
    </div>
    <div class="flex justify-center">
      <CheckBookForm
        client:load
        buttonText={button}
        invalidNumber={invalidNumber}
      />
    </div>
    <div>
      <h2>Detalles del viaje</h2>
      <div>
        <BookDetails />
      </div>
    </div>
  </div>
</section>
