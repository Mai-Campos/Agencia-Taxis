---
import Button from '@/components/ui/Button.astro'

type Props = {
  text: string
}

const { text } = Astro.props
---

<section class="body-font">
  <div class="container mx-auto px-5 py-24">
    <main
      class="mx-auto flex flex-col items-start sm:flex-row sm:items-center lg:w-3/4"
    >
      <h2 class="title-font mb-10 grow text-2xl font-medium sm:mb-0 sm:pr-14">
        {text}
      </h2>
      <Button text="Crear Recorrido" />
    </main>
  </div>
</section>
