---
import ServiceCard from '@/components/ui/ServiceCard.astro'
import { getCollection } from 'astro:content'

type Props = {
  title: string
  subtitle: string
}
const locale = Astro.currentLocale || 'es'
const services = await getCollection('service-card', ({ slug }) =>
  slug.startsWith(`${locale}/`)
)

const { title, subtitle } = Astro.props
---

<section id="services" class="body-font text-gray-600">
  <div class="container mx-auto px-5 py-8">
    <div class="mb-10 flex w-full flex-col text-center">
      <h2
        class="text-primary title-font mb-1 text-xs font-medium tracking-widest"
      >
        {subtitle}
      </h2>
      <h1 class="title-font text-2xl font-medium text-gray-900 sm:text-3xl">
        {title}
      </h1>
    </div>
    <div class="flex flex-wrap">
      {
        services.map((service) => {
          const { title, description, icon } = service.data
          return <ServiceCard title={title} description={description} icon={icon} />
        })
      }
    </div>
  </div>
</section>
