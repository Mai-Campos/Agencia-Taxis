---
import { Icon } from 'astro-icon/components'
---

<section class="body-font bg-plane">
  <div class="container mx-auto flex flex-wrap px-5 py-24 md:max-w-[1100px]">
    <h2 class="title-font mb-2 text-2xl text-white font-medium sm:text-3xl md:w-2/5">
      Traslados entre aeropuertos y hoteles o casas de alquiler
    </h2>
    <aside class="md:w-3/5 md:pl-6">
      <p class="text-gray-100 text-base leading-relaxed">
        Taxidermy bushwick celiac master cleanse microdosing seitan. Fashion axe
        four dollar toast truffaut, direct trade kombucha brunch williamsburg
        keffiyeh gastropub tousled squid meh taiyaki drinking vinegar tacos.
      </p>
      <div class="mt-6 flex md:mt-4">
        <a class="go-to" href="/airport-transfers"
          >Ver Traslados <Icon name="tabler:arrow-narrow-right" size={22} /></a
        >
      </div>
    </aside>
  </div>
</section>

<style>
  .bg-plane {
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
      url('/bg-plane.webp');

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
</style>
