---
import { Icon } from 'astro-icon/components'
import { getRelativeLocaleUrl } from 'astro:i18n'

type Props = {
  title: string
  description: string
  link: string
}

const currentLang = Astro.currentLocale || 'es'
const { title, description, link } = Astro.props
---

<section class="body-font bg-plane">
  <div class="container mx-auto flex flex-wrap px-5 py-24 md:max-w-[1100px]">
    <h2
      class="title-font mb-2 text-2xl font-medium text-white sm:text-3xl md:w-2/5"
    >
      {title}
    </h2>
    <aside class="md:w-3/5 md:pl-6">
      <p class="text-base leading-relaxed text-gray-100">
        {description}
      </p>
      <div class="mt-6 flex md:mt-4">
        <a class="go-to color-transition" href={getRelativeLocaleUrl(currentLang, 'book-transfer')}
          >{link}<Icon name="tabler:arrow-narrow-right" size={22} /></a
        >
      </div>
    </aside>
  </div>
</section>

<style>
  .bg-plane {
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
      url('/bg-plane.webp');

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
</style>
