---
import BookDetails from '@/components/sections/details-sections/BookDetails'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getTranslations } from '@/i18n/index'
import type { Language } from '@/i18n/types'
import { LANG_PATHS } from '@/i18n/ui'
import '@/styles/global.css'

export async function getStaticPaths() {
  return LANG_PATHS.map(({ params }) => ({ params: { lang: params.lang } }))
}
const lang = Astro.params.lang as Language

const t = await getTranslations('literals', lang)
---

<BaseLayout
  headerType="static"
  title="Inicio"
  footer={t.footer}
  navbar={t.navbar}
  lang={lang}
>
  <div class="container mx-auto px-5 py-24">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-semibold">{t.confirmBook.title}</h1>
      <p class="text-text-secondary mt-2">
        {t.confirmBook.subtitle}
      </p>
    </div>
    <BookDetails labels={t.checkBook.bookDetails} client:load />
  </div>
</BaseLayout>
