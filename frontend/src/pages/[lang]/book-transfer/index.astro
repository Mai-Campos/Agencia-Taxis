---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getTranslations } from '@/i18n/index'
import type { Language } from '@/i18n/types'
import TransferForm from '@/components/sections/TransferForm.astro'
import '@/styles/global.css'

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }]
}
export const defafultRedirect = '/es'
const lang = Astro.params.lang as Language

const t = await getTranslations('literals', lang)
---

<BaseLayout headerType="static" title="Inicio" navbar={t.navbar} lang={lang}>
  <TransferForm />
</BaseLayout>
