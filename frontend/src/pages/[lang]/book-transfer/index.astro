---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getTranslations } from '@/i18n/index'
import type { Language } from '@/i18n/types'
import TransferForm from '@/components/forms/TransferForm'
import '@/styles/global.css'
import { LANG_PATHS } from '@/i18n/ui'

export async function getStaticPaths() {
  return LANG_PATHS.map(({ params }) => ({ params: { lang: params.lang } }))
}
const lang = Astro.params.lang as Language

const t = await getTranslations('literals', lang)
---

<BaseLayout headerType="static" title="Inicio" navbar={t.navbar} lang={lang}>
  <TransferForm {...t.transferForm} client:only />
</BaseLayout>
