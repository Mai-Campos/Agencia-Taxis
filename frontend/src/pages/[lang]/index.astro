---
import Hero from '@/components/sections/Hero.astro'
import TripsSection from '@/components/sections/TripsSection.astro'
import TransfersSection from '@/components/sections/TransfersSection.astro'
import SeeAllTripsLink from '@/components/ui/SeeAllTripsLink.astro'
import CallToAction from '@/components/sections/CallToAction.astro'
import TripCard from '@/components/ui/TripCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ServicesSection from '@/components/sections/ServicesSection.astro'
import { getTranslations } from '@/i18n/index'
import { LANG_PATHS } from '@/i18n/ui'
import type { Language } from '@/i18n/types'
import { getCollection } from 'astro:content'
import '@/styles/global.css'

export async function getStaticPaths() {
  return LANG_PATHS.map(({ params }) => ({ params: { lang: params.lang } }))
}

const lang = Astro.params.lang as Language

const trips = await getCollection('trips', ({ slug }) =>
  slug.startsWith(`${lang}/`)
)

const topTrips = trips.slice(0, 4)

const t = await getTranslations('literals', lang)
---

<BaseLayout
  headerType="scroll"
  title="Inicio"
  footer={t.footer}
  navbar={t.navbar}
  lang={lang}
>
  <Hero
    {...t.hero}
    tripBtn={t.button.tripText}
    transferBtn={t.button.transferText}
  />
  <ServicesSection {...t.servicesInfo} />
  <TripsSection
    description={t.tripsContainer.description}
    title={t.tripsContainer.title}
  >
    {
      topTrips.map(({ data }) => (
        <TripCard
          location={data.location}
          packageName={data.packageName}
          img={data.img}
          path={data.path}
        />
      ))
    }
  </TripsSection>
  <SeeAllTripsLink {...t.seeAllTripsLink} />
  <TransfersSection {...t.airportTravels} />
  <CallToAction
    {...t.callToAction}
    tripBtn={t.button.tripText}
    transferBtn={t.button.transferText}
  />
</BaseLayout>
