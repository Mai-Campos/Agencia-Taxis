---
import Hero from '@/components/sections/Hero.astro'
import TripsContainer from '@/components/sections/TripsContainer.astro'
import AirportTravels from '@/components/sections/AirportTravels.astro'
import SeeAllTripsLink from '@/components/ui/SeeAllTripsLink.astro'
import CallToAction from '@/components/sections/CallToAction.astro'
import TripCard from '@/components/ui/TripCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ServicesInfo from '@/components/sections/ServicesInfo.astro'
import { getCollection } from 'astro:content'
import { getTranslations } from '@/i18n/index'
import '@/styles/global.css'
import type { Language } from '@/i18n/types'

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }]
}
export const defafultRedirect = '/es'

const lang = Astro.params.lang as Language

const trips = await getCollection('trip-card', ({ slug }) =>
  slug.startsWith(`${lang}/`)
)

const topTrips = trips.slice(0, 4)

const t = await getTranslations('literals', lang)
---

<BaseLayout headerType="scroll" title="Inicio" navbar={t.navbar} lang={lang}>
  <Hero {...t.hero} />
  <ServicesInfo {...t.servicesInfo} />
  <TripsContainer
    description={t.tripsContainer.description}
    title={t.tripsContainer.title}
  >
    {
      topTrips.map(({ data }) => (
        <TripCard
          location={data.location}
          packageName={data.packageName}
          img={data.img}
          path={data.path}
        />
      ))
    }
  </TripsContainer>
  <SeeAllTripsLink {...t.seeAllTripsLink} />
  <AirportTravels {...t.airportTravels} />
  <CallToAction {...t.callToAction} />
</BaseLayout>
