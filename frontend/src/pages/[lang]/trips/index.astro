---
import BaseLayout from '@/layouts/BaseLayout.astro'
import TripsSection from '@/components/sections/TripsSection.astro'
import CallToAction from '@/components/sections/CallToAction.astro'
import TripCard from '@/components/ui/TripCard.astro'
import { getTranslations } from '@/i18n/index'
import type { Language } from '@/i18n/types'
import { LANG_PATHS } from '@/i18n/ui'
import { getCollection } from 'astro:content'
import '@/styles/global.css'

export async function getStaticPaths() {
  return LANG_PATHS.map(({ params }) => ({ params: { lang: params.lang } }))
}

const lang = Astro.params.lang as Language

const trips = await getCollection('trips', ({ slug }) =>
  slug.startsWith(`${lang}/`)
)
const t = await getTranslations('literals', lang)
---

<BaseLayout headerType="static" title="Inicio" navbar={t.navbar} lang={lang}>
  <TripsSection
    description={t.tripsContainer.description}
    title={t.tripsContainer.title}
  >
    {
      trips.map((trip) => {
        const { data } = trip
        const { location, packageName, img, path } = data
        return (
          <TripCard
            location={location}
            packageName={packageName}
            img={img}
            path={path}
          />
        )
      })
    }
  </TripsSection>
  <CallToAction
    {...t.callToAction}
    tripBtn={t.button.tripText}
    transferBtn={t.button.transferText}
  />
</BaseLayout>
