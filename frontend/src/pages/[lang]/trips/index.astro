---
import BaseLayout from '@/layouts/BaseLayout.astro'
import TripsContainer from '@/components/sections/TripsContainer.astro'
import CallToAction from '@/components/sections/CallToAction.astro'
import TripCard from '@/components/ui/TripCard.astro'
import { getCollection } from 'astro:content'
import { getTranslations } from '@/i18n/index'
import '@/styles/global.css'
import type { Language } from '@/i18n/types'
import { LANG_PATHS } from '@/i18n/ui'

export async function getStaticPaths() {
  return LANG_PATHS
}
export const defafultRedirect = '/es'

const lang = Astro.params.lang as Language

const trips = await getCollection('trips', ({ slug }) =>
  slug.startsWith(`${lang}/`)
)
const t = await getTranslations('literals', lang)
---

<BaseLayout headerType="static" title="Inicio" navbar={t.navbar} lang={lang}>
  <TripsContainer
    description={t.tripsContainer.description}
    title={t.tripsContainer.title}
  >
    {
      trips.map((trip) => {
        const { data } = trip
        const { location, packageName, img, path } = data
        return (
          <TripCard
            location={location}
            packageName={packageName}
            img={img}
            path={path}
          />
        )
      })
    }
  </TripsContainer>
  <CallToAction {...t.callToAction} textBtn={t.button.text} />
</BaseLayout>
