---
import BaseLayout from '@/layouts/BaseLayout.astro'
import TripInfo from '@/components/sections/TripInfo.astro'
import { getTranslations } from '@/i18n/index'
import { getCollection } from 'astro:content'
import '@/styles/global.css'

export async function getStaticPaths() {
  const trips = await getCollection('trip-card')

  return trips.map((trip) => {
    const [locale] = trip.id.split('/')

    return {
      params: { 
        locale,
        id: trip.data.path, 
      },
      props: { trip },
    }
  })
}

const locale = Astro.currentLocale || 'es'
const t = await getTranslations('home', locale)
const { trip } = Astro.props
const { location, packageName, img, placesToVisit, price } = trip.data
---

<BaseLayout
  headerType="static"
  title=`Viaje | ${packageName}`
  navbar={t.navbar}
>
  <TripInfo
    location={location}
    packageName={packageName}
    img={img}
    placesToVisit={placesToVisit}
    price={price}
  />
</BaseLayout>
