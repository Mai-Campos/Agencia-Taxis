---
import Hero from '@/components/sections/Hero.astro'
import TripsContainer from '@/components/sections/TripsContainer.astro'
import AirportTravels from '@/components/sections/AirportTravels.astro'
import SeeAllTripsLink from '@/components/ui/SeeAllTripsLink.astro'
import CallToAction from '@/components/sections/CallToAction.astro'
import TripCard from '@/components/ui/TripCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ServicesInfo from '@/components/sections/ServicesInfo.astro'
import { getCollection } from 'astro:content'
import { getTranslations } from '@/i18n/index'
import '@/styles/global.css'

const locale = Astro.currentLocale || 'es'

const trips = await getCollection('route-cards')
const t = await getTranslations('home', locale);
---

<BaseLayout headerType="scroll" title='Home'>
  <Hero {...t.hero} />
  <ServicesInfo />
  <TripsContainer>
    {
      trips.map((trip) => {
        const { location, packageName, img } = trip.data
        return (
          <TripCard location={location} packageName={packageName} img={img} />
        )
      })
    }
  </TripsContainer>
  <SeeAllTripsLink />
  <AirportTravels />
  <CallToAction />
</BaseLayout>
