---
import BaseLayout from '@/layouts/BaseLayout.astro'
import TripsContainer from '@/components/sections/TripsContainer.astro'
import CallToAction from '@/components/sections/CallToAction.astro'
import TripCard from '@/components/ui/TripCard.astro'
import { getCollection } from 'astro:content'
import { getTranslations } from '@/i18n/index'
import '@/styles/global.css'

const locale = Astro.currentLocale || 'es'

const trips = await getCollection('trip-card', ({ slug }) =>
  slug.startsWith(`${locale}/`)
)
const t = await getTranslations('home', locale)
---

<BaseLayout headerType="static" title="Inicio" navbar={t.navbar}>
  <TripsContainer
    description={t.tripsContainer.description}
    title={t.tripsContainer.title}
  >
    {
      trips.map((trip) => {
        const { data } = trip
        const { location, packageName, img, path } = data
        return (
          <TripCard
            location={location}
            packageName={packageName}
            img={img}
            path={path}
          />
        )
      })
    }
  </TripsContainer>
  <CallToAction {...t.callToAction} />
</BaseLayout>
