---
import BaseLayout from '@/layouts/BaseLayout.astro'
import TripsContainer from '@/components/sections/TripsContainer.astro'
import CallToAction from '@/components/sections/CallToAction.astro'
import TripCard from '@/components/ui/TripCard.astro'
import '@/styles/global.css'
import { getCollection } from 'astro:content'

const trips = await getCollection('route-cards')
---

<BaseLayout headerType="static">
  <TripsContainer>
        {
      trips.map((trip) => {
        const { location, packageName, img } = trip.data
        return (
          <TripCard location={location} packageName={packageName} img={img} />
        )
      })
    }
  </TripsContainer>
  <CallToAction />
</BaseLayout>
