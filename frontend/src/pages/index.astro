---
import Hero from '@/components/sections/Hero.astro'
import RoutesContainer from '@/components/sections/RoutesContainer.astro'
import AirportTravels from '@/components/sections/AirportTravels.astro'
import SeeAllRoutesLink from '@/components/ui/SeeAllRoutesLink.astro'
import CallToAction from '@/components/sections/CallToAction.astro'
import RouteCard from '@/components/ui/RouteCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import '@/styles/global.css'
import ServicesInfo from '@/components/sections/ServicesInfo.astro'
import { getCollection } from 'astro:content'

const routes = await getCollection('route-cards')
---

<BaseLayout headerType="scroll">
  <Hero />
  <ServicesInfo />
  <RoutesContainer>
    {
      routes.map((route) => {
        const { location, packageName, img } = route.data
        return (
          <RouteCard location={location} packageName={packageName} img={img} />
        )
      })
    }
  </RoutesContainer>
  <SeeAllRoutesLink />
  <AirportTravels />
  <CallToAction />
</BaseLayout>
